          "args": {
            "index": 0
          },
          "expect": {
            "public.total": 3,
            "state.loaded.0": true
          }
        },
        {
          "tool": "dispatch",
          "args": {},
          "expect": {
            "state.status": "under",
            "result.ok": false
          }
        },
        {
          "tool": "amnesty",
          "args": {},
          "expect": {
            "public.total": 1,
            "state.pardoned": true
          }
        },
        {
          "tool": "load",
          "args": {
