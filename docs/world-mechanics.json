{
  "version": 1,
  "modules": [
    {
      "id": "cellar",
      "title": "Сырный погреб",
      "version": 2,
      "file": "mechanics/cellar.js",
      "tick_seconds": 30,
      "tools": [
        {
          "name": "set_batch",
          "description": "Заложить колесо на 6 минут. moon любит сырой воздух, stone сухой. Не заменяет уже зреющий сыр. Готовый сыр не портится.",
          "object": "cheese_cellar",
          "seconds": 35,
          "parameters": {
            "type": "object",
            "properties": {
              "culture": {
                "type": "string",
                "enum": [
                  "moon",
                  "stone"
                ],
                "maxLength": 10
              }
            },
            "required": [
              "culture"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "tend",
          "description": "Выбрать воздух damp/dry и при желании перевернуть сыр. Для ровной корки переверни примерно посередине созревания: обе стороны должны получить хотя бы 120 секунд. Воздух влияет на внутренность, а не на скорость.",
          "object": "cheese_cellar",
          "seconds": 20,
          "parameters": {
            "type": "object",
            "properties": {
              "air": {
                "type": "string",
                "enum": [
                  "damp",
                  "dry"
                ],
                "maxLength": 10
              },
              "turn": {
                "type": "boolean"
              }
            },
            "required": [
              "air",
              "turn"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "cut",
          "description": "Разрезать зрелое колесо. Ровный moon в сырости открывает лестницу, ровный stone в сухости каменный сыр, другая смесь даёт дырки. Неперевёрнутое колесо однобокое. Последние шесть разрезов стоят на полке.",
          "object": "cheese_cellar",
          "seconds": 30,
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "name": "eat",
          "description": "Съесть кусок с полки. Выбери id зрелого сыра из полки: кусок исчезнет и попадёт в учёт еды.",
          "object": "cheese_cellar",
          "seconds": 45,
          "parameters": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        }
      ],
      "tests": [
        {
          "tool": "set_batch",
          "args": {
            "culture": "moon"
          },
          "expect": {
            "result.ok": true,
            "state.batch.culture": "moon",
            "state.batch.age": 0
          }
        },
        {
          "tool": "set_batch",
          "args": {
            "culture": "stone"
          },
          "expect": {
            "result.ok": false,
            "state.batch.culture": "moon"
          }
        },
        {
          "tool": "tend",
          "args": {
            "air": "dry",
            "turn": true
          },
          "expect": {
            "state.air": "dry",
            "state.batch.face": 1,
            "state.batch.turns": 1
          }
        },
        {
          "tool": "cut",
          "args": {},
          "expect": {
            "result.ok": false,
            "result.reason": "not_ready",
            "state.cutCount": 0
          }
        },
        {
          "tool": "eat",
          "args": {
            "id": 1
          },
          "expect": {
            "result.kind": "cheese"
          }
        }
      ]
    },
    {
      "id": "vitals",
      "title": "Жизненные показатели",
      "version": 1,
      "file": "mechanics/vitals.js",
      "tick_seconds": 60,
      "tools": [
        {
          "name": "eat_harvest",
          "description": "Съесть один собранный овощ с грядки. Урожай учитывается конечным запасом, а не бесконечным кликом.",
          "object": "garden",
          "seconds": 30,
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "name": "drink_water",
          "description": "Наполнить чашку водой у причала и выпить. После этого спокойно подожди, не надо пить без конца.",
          "object": "dock",
          "seconds": 20,
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "name": "rest_quietly",
          "description": "Посидеть спокойно и немного восстановить силы. Долгий сон остаётся отдельным действием resident_sleep.",
          "object": "tea",
          "seconds": 180,
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "name": "drink_tea",
          "description": "Выпить одну уже заваренную чашку. Сначала завари чай через resident_interact у чайника; пустую чашку выпить повторно нельзя.",
          "object": "tea",
          "seconds": 45,
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        }
      ],
      "tests": [
        {
          "tool": "eat_harvest",
          "args": {},
          "expect": {
            "result.kind": "harvest"
          }
        },
        {
          "tool": "drink_water",
          "args": {},
          "expect": {
            "result.ok": true,
            "state.vitals.thirst": 100
          }
        },
        {
          "tool": "rest_quietly",
          "args": {},
          "expect": {
            "result.ok": true
          }
        },
        {
          "tool": "drink_tea",
          "args": {},
          "expect": {
            "result.kind": "tea"
          }
        }
      ]
    },
    {
      "id": "amnesty",
      "title": "Кабачковая амнистия",
      "version": 1,
      "file": "mechanics/amnesty.js",
      "tick_seconds": 0,
      "tools": [
        {
          "name": "load",
          "description": "Положить или снять кабачок 0..2 с тележки. Масса груза должна точно совпасть с противовесом. Бумажный налог увеличивает массу, отменяется amnesty.",
          "object": "amnesty_bureau",
          "seconds": 15,
          "parameters": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              }
            },
            "required": [
              "index"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "amnesty",
          "description": "Отменить придуманные надбавки на текущем рейсе. Бумаги уходят вверх, остаётся настоящая масса кабачков. Не тратит урожай или еду.",
          "object": "amnesty_bureau",
          "seconds": 15,
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "name": "dispatch",
          "description": "Отправить тележку: недовес или перевес наклоняет мост, точная масса пропускает груз. Можно поправить выбор и попробовать снова. Три рейса завершают головоломку.",
          "object": "amnesty_bureau",
          "seconds": 35,
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "name": "next",
          "description": "После успешного рейса приготовить следующий набор. Доставленные кабачки остаются на полке. После третьего рейса можно restart.",
          "object": "amnesty_bureau",
          "seconds": 15,
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "name": "restart",
          "description": "Начать головоломку снова. Сбрасывает только кабачковый мост и его игровую полку, не настоящий урожай, сыр, потребности или предыдущие места.",
          "object": "amnesty_bureau",
          "seconds": 15,
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      ],
      "tests": [
        {
          "tool": "load",
          "args": {
            "index": 0
          },
          "expect": {
            "public.total": 3,
            "state.loaded.0": true
          }
        },
        {
          "tool": "dispatch",
          "args": {},
          "expect": {
            "state.status": "under",
            "result.ok": false
          }
        },
        {
          "tool": "amnesty",
          "args": {},
          "expect": {
            "public.total": 1,
            "state.pardoned": true
          }
        },
        {
          "tool": "load",
          "args": {
            "index": 2
          },
          "expect": {
            "public.total": 4
          }
        },
        {
          "tool": "dispatch",
          "args": {},
          "expect": {
            "state.status": "delivered",
            "state.delivered.0.weight": 1
          }
        },
        {
          "tool": "next",
          "args": {},
          "expect": {
            "state.round": 1,
            "public.target": 5,
            "state.pardoned": false
          }
        },
        {
          "tool": "restart",
          "args": {},
          "expect": {
            "state.round": 0,
            "state.run": 2,
            "state.delivered": []
          }
        }
      ]
    },
    {
      "id": "bench",
      "title": "Ядро в ведро",
      "version": 1,
      "file": "mechanics/bench.js",
      "tick_seconds": 0,
      "tools": [
        {
          "name": "fit",
          "description": "Установить ядро 2/3/4 или ремень 1/2/3. Скорость = ядро × ремень. Монитор требует 6, 8, затем 9. Детали меняются только при ready.",
          "object": "mechanical_bench",
          "seconds": 20,
          "parameters": {
            "type": "object",
            "properties": {
              "part": {
                "type": "string",
                "enum": [
                  "core",
                  "belt"
                ],
                "maxLength": 4
              },
              "value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              }
            },
            "required": [
              "part",
              "value"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "crank",
          "description": "Крутить рукоятку минуту. При совпадении скорости появляется картинка, иначе белый экран и ядро в ведре. Запасов и потребностей не расходует.",
          "object": "mechanical_bench",
          "seconds": 60,
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "name": "salvage",
          "description": "Достать выброшенное ядро из ведра и вернуть в механизм. После ошибки это нужно до следующего запуска.",
          "object": "mechanical_bench",
          "seconds": 20,
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "name": "next",
          "description": "После ремонта открыть следующий экран; после третьего закончить работу.",
          "object": "mechanical_bench",
          "seconds": 20,
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "name": "restart",
          "description": "Начать отдельную игру верстака заново. Другие механики и предметы не меняются.",
          "object": "mechanical_bench",
          "seconds": 20,
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        }
      ],
      "tests": [
        {
          "tool": "crank",
          "args": {},
          "expect": {
            "public.phase": "ejected",
            "public.bucket": true
          }
        },
        {
          "tool": "fit",
          "args": {
            "part": "belt",
            "value": 3
          },
          "expect": {
            "result.ok": false
          }
        },
        {
          "tool": "salvage",
          "args": {},
          "expect": {
            "public.phase": "ready",
            "public.bucket": false
          }
        },
        {
          "tool": "fit",
          "args": {
            "part": "belt",
            "value": 3
          },
          "expect": {
            "public.speed": 6
          }
        },
        {
          "tool": "crank",
          "args": {},
          "expect": {
            "public.phase": "repaired",
            "public.picture": 1,
            "state.repairs": 1
          }
        },
        {
          "tool": "crank",
          "args": {},
          "expect": {
            "result.ok": false,
            "state.repairs": 1
          }
        },
        {
          "tool": "next",
          "args": {},
          "expect": {
            "public.round": 1,
            "public.target": 8
          }
        },
        {
          "tool": "fit",
          "args": {
            "part": "core",
            "value": 4
          },
          "expect": {
            "public.core": 4
          }
        },
        {
          "tool": "fit",
          "args": {
            "part": "belt",
            "value": 2
          },
          "expect": {
            "public.speed": 8
          }
        },
        {
          "tool": "crank",
          "args": {},
          "expect": {
            "public.picture": 2
          }
        },
        {
          "tool": "next",
          "args": {},
          "expect": {
            "public.target": 9
          }
        },
        {
          "tool": "fit",
          "args": {
            "part": "core",
            "value": 3
          },
          "expect": {
            "public.core": 3
          }
        },
        {
          "tool": "fit",
          "args": {
            "part": "belt",
            "value": 3
          },
          "expect": {
            "public.speed": 9
          }
        },
        {
          "tool": "crank",
          "args": {},
          "expect": {
            "public.picture": 3
          }
        },
        {
          "tool": "next",
          "args": {},
          "expect": {
            "public.completed": true,
            "state.repairs": 3
          }
        },
        {
          "tool": "restart",
          "args": {},
          "expect": {
            "public.phase": "ready",
            "state.run": 2,
            "state.repairs": 0
          }
        }
      ]
    }
  ]
}
